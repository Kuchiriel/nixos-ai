		"MD032": false,
		"MD033": false,
		"MD040": false,
		"MD050": false,
		"MD060": false,
		"MD034": false,
		"MD036": false,
		"MD023": false,
		"MD047": false,
		"MD037": false,
		"MD055": false,
		"MD038": false,
		"MD046": false,
		"MD003": false,
		"MD005": false,
		"MD058": false
	},
	"ignorePatterns": ["archive/_trash/**", "**/_trash/**", "docs/archive/_trash/**", "archive/**"]
