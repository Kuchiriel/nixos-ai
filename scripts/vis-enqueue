#!/usr/bin/env bash
# vis-enqueue — enfileira comunicacao visivel para injetar na sessao ociosa do dono.
#
# COMO FUNCIONA (igual ao auto-wake do Termux):
#   1. Qualquer agente/encomenda enfileira:  vis-enqueue "<tarefa>"
#   2. Quando a sessao do dono fica ociosa, o plugin memory.js injeta
#      via ctx.session.synthetic() na sessao — o dono VE na janela do OpenCode.
#   3. Fila vazia = nada e injetado (sem loop infinito).
#
# Comandos:
#   vis-enqueue "<tarefa>"     # enfileira (fila FIFO)
#   vis-enqueue next           # imprime e remove a proxima
#   vis-enqueue status         # fila + orcamento de wakes
#   vis-enqueue budget         # interno: 0 = pode injetar, 1 = sem orcamento
#   vis-enqueue limit N        # ajusta maximo de injecoes/hora (default 12)
set -uo pipefail
export PATH="$HOME/.nix-profile/bin:/run/current-system/sw/bin:$PATH"
STATE="$HOME/.local/state/jarvis"
QUEUE="$STATE/vis-queue.txt"
BUDGET="$STATE/vis-wake-budget.json"
mkdir -p "$STATE"
[ -f "$QUEUE" ] || : > "$QUEUE"
MAX_PER_HOUR="${VIS_MAX_PER_HOUR:-12}"
MIN_GAP_MIN="${VIS_MIN_GAP_MIN:-3}"
# (19/11, medido) UNIDADE UNICA = milissegundos. O plugin memory.js escreve
# `last` com Date.now() (ms) e o script lia/escrevia com date +%s (s): o status
# imprimia "ultimo ha -29888226094min" e o gap comparava segundos contra
# gap*60*1000, ou seja exigia 180000 s (~50 h) entre injecoes. Agora tudo em
# ms, e um valor legado (<1e12) e normalizado multiplicando por 1000.
now=$(date +%s)
now_ms=$(date +%s%3N)
[ -n "$now_ms" ] && [ "${#now_ms}" -ge 10 ] || now_ms=$(( now * 1000 ))
cmd_enqueue() {
  local t="$*"
  [ -z "$t" ] && { echo "vis-enqueue: tarefa vazia" >&2; exit 2; }
  grep -Fxq "$t" "$QUEUE" 2>/dev/null || echo "$t" >> "$QUEUE"
  echo "vis-enqueue: enfileirado ($(wc -l < "$QUEUE") na fila) :: $t"
}
cmd_next() {
  [ -s "$QUEUE" ] || exit 1
  local t
  t=$(head -1 "$QUEUE")
  tail -n +2 "$QUEUE" > "$QUEUE.tmp" 2>/dev/null && mv "$QUEUE.tmp" "$QUEUE"
  printf '%s\n' "$t"
}
cmd_status() {
  local pend=0
  if [ -s "$QUEUE" ]; then pend=$(grep -c . "$QUEUE" 2>/dev/null | head -1); pend=${pend:-0}; else pend=0; fi
  local ultima_min=0 usados=0
  if [ -f "$BUDGET" ]; then
    usados=$(python3 -c "
import json,sys
try:
    d=json.load(open('$BUDGET'))
    print(d.get('count',0) if int(d.get('hour',0))==int($now_ms//3600000) else 0)
except Exception: print(0)
" 2>/dev/null)
    ultima_min=$(python3 -c "
import json,sys
try:
    last=int(json.load(open('$BUDGET')).get('last',0) or 0)
except Exception:
    sys.exit(0)
if 0 < last < 10**12: last *= 1000   # legado em segundos
print(max(0, int(($now_ms-last)//60000)))
" 2>/dev/null)
  fi
  [ -n "$usados" ] || usados=0
  [ -n "$ultima_min" ] || ultima_min=0
  echo "vis-enqueue: fila=$pend | injecoes nesta hora=$usados/$MAX_PER_HOUR | ultimo ha ${ultima_min}min | alvo=$(cat "$STATE/vis-session" 2>/dev/null || echo 'qualquer')"
  [ "$pend" -gt 0 ] && sed 's/^/  - /' "$QUEUE" | head -5
  return 0
}
cmd_budget() {
  python3 - "$BUDGET" "$now_ms" "$MAX_PER_HOUR" "$MIN_GAP_MIN" <<'PY'
import json, os, sys
path, now, mx, gap = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
d = {"count": 0, "hour": now // 3600000, "last": 0}
try:
    d = json.load(open(path))
except Exception:
    pass
if d.get("hour") != now // 3600000:
    d = {"count": 0, "hour": now // 3600000, "last": d.get("last", 0)}
last = int(d.get("last", 0) or 0)
if 0 < last < 10**12:   # legado em segundos -> ms
    last *= 1000
if d.get("count", 0) >= mx:
    print("BLOQUEADO")
    sys.exit(1)
if now - last < gap * 60 * 1000:
    print("BLOQUEADO")
    sys.exit(1)
d["count"] = d.get("count", 0) + 1
d["last"] = now
json.dump(d, open(path, "w"))
print("OK")
sys.exit(0)
PY
}
case "${1:-status}" in
  enqueue) shift; cmd_enqueue "$*" ;;
  next) cmd_next ;;
  status) cmd_status ;;
  budget) cmd_budget ;;
  session)
    if [ -n "${2:-}" ]; then
      echo "$2" > "$STATE/vis-session"
      echo "vis-enqueue: sessao alvo = $2 (so ela recebe as injecoes)"
    else
      printf 'vis-enqueue: alvo = %s\n' "$(cat "$STATE/vis-session" 2>/dev/null || echo '(nenhum: qualquer sessao ociosa recebe)')"
    fi
    ;;
  limit) echo "max por hora: ${2:-$MAX_PER_HOUR}" ;;
  # A forma documentada e `vis-enqueue "<tarefa>"`. Antes esta rota caia em
  # `*) cmd_status`: imprimia o status e descartava a tarefa silenciosamente.
  *) cmd_enqueue "$*" ;;
esac
