{ config, pkgs, lib, stateVersion, hostname, user, ... }:

# ═══════════════════════════════════════════════════════════════════════
# HOST ALVO — Acer Nitro V15 (RTX 4050 6GB / 32GB RAM / i7-13620H)
#
# "Sistema operacional de bordo com IA embutida" — o host nasce com o
# JARVIS declarado, e o switch central `services.jarvis.environment`
# liga TUDO automaticamente (água):
#
#   - llama-cpp      → profile "host": Qwen3.6-35B-A3B MoE + vision,
#                      expert offload (atenção GPU, experts RAM)
#   - waybar         → full: battery/bluetooth/backlight (hardware real)
#   - mpvpaper       → wallpaper animado mp4 na iGPU (decode VA-API)
#   - whisper STT    → iGPU Intel UHD via SYCL (12x boost)
#   - hyprland       → animações/efeitos completos (sem VM)
#
# INSTALAÇÃO (no host, com o ISO NixOS):
#   1. Particione o disco + `nixos-generate-config --root /mnt`
#      → substitua ./hardware-configuration.nix pelo gerado
#   2. `nixos-install --flake .#nitro-v15`
#   3. No boot: `sudo nixos-rebuild switch --flake .#nitro-v15`
#
# NOTA: não registrado no flake.nix até o hardware-configuration.nix real
# existir (o eval falharia sem ele). Ative quando o host estiver pronto.
# ═══════════════════════════════════════════════════════════════════════

let
  servicesDir = ../../modules/services;
  dynamicServiceImports =
    if builtins.pathExists servicesDir then
      lib.mapAttrsToList
        (name: type: servicesDir + "/${name}")
        (lib.filterAttrs (name: type: type == "regular" && lib.hasSuffix ".nix" name) (builtins.readDir servicesDir))
    else [];
in
{
  imports = [
    ./hardware-configuration.nix
    ../../nixos/modules
  ] ++ dynamicServiceImports;

  # ── O SWITCH (1 linha que liga o host inteiro) ──────────────────────
  services.jarvis.enable = true;
  services.jarvis.environment = "host";

  # =========================================================================
  # 1. HARDWARE — NVIDIA RTX 4050 (dGPU) + Intel UHD (iGPU)
  # =========================================================================
  # dGPU: drivers proprietários (CUDA p/ llama.cpp). iGPU: VA-API p/ decode.
  hardware.nvidia = {
    package = config.boot.kernelPackages.nvidiaPackages.stable;
    modesetting.enable = true;
    open = false;                 # 4050 suporta open, mas stable fecha melhor
    nvidiaSettings = true;
  };
  services.xserver.videoDrivers = [ "nvidia" ];
  # iGPU Intel (decode de vídeo do mpvpaper/whisper via VA-API)
  hardware.graphics.enable = true;
  hardware.graphics.extraPackages = with pkgs; [ intel-media-driver ];

  # Largura de banda do NVMe (não afeta GPU — só sanity)
  boot.kernelParams = [ "nvidia-drm.modeset=1" ];

  # =========================================================================
  # 2. SERVIÇOS JARVIS — tudo declarativo, segue o switch
  # =========================================================================
  services.llama-cpp-server.enable = true;   # profile segue environment=host
  services.llama-cpp-embeddings.enable = true;
  services.llama-cpp-rerank.enable = true;
  services.qdrant.enable = true;
  # Cascade/handover: local (Qwen3.6-35B MoE) → nuvem grátis se falhar/lento.
  # Chaves em /etc/litellm.env (fora do repo); sem elas, roda só local.
  services.litellm.enable = true;

  # =========================================================================
  # 3. USUÁRIO + SUDO (o perfil host roda o llama como root p/ scheduler fifo)
  # =========================================================================
  users.users.${user} = {
    isNormalUser = true;
    extraGroups = [ "wheel" "video" "audio" "networkmanager" ];
  };
  security.sudo.extraRules = [{
    users = [ user ];
    commands = [{ command = "ALL"; options = [ "NOPASSWD" ]; }];
  }];

  # =========================================================================
  # 4. SISTEMA
  # =========================================================================
  system.stateVersion = stateVersion;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
}
